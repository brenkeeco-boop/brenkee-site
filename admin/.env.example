# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Project Settings → API no painel do Supabase).
# Nunca coloque a "service_role key" aqui — só a URL e a anon/publishable key,
# que são seguras para expor no frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
